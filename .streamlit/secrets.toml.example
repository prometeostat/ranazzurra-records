# Copia questo file in .streamlit/secrets.toml (che NON va nel repository)
# e compila i valori. Su Streamlit Community Cloud lo stesso contenuto va
# incollato in Settings > Secrets dell'app.

[mysql]
host = "record-societari-swim-project.j.aivencloud.com"
port = 17236
database = "defaultdb"
user = "avnadmin"
password = "..."
# percorso del certificato CA di Aiven (relativo alla cartella del progetto)
# oppure il PEM incollato tra triple virgolette
ssl_ca = "ca.pem"

# Solo per esporta_records.py, lanciato in locale
[ftp]
host = "..."
user = "..."
password = "..."
cartella = "/public_html/records"
# FTP su TLS (consigliato). Metti false solo se Register.it lo rifiuta.
tls = true

# Facoltativo: lettura dei PDF dei risultati da Google Drive
# (vedi docs/google-drive-integration.md)
[gdrive]
folder_id = "..."            # id della cartella con i PDF dei risultati
profondita_massima = 3       # quante sottocartelle scendere

[gdrive.service_account]     # contenuto del file JSON del service account
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
